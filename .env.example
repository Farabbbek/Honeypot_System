# ============================================================
# Adaptive Honeypot System — Environment Variables
#
# ВАЖНО: этот файл — шаблон для справки.
# docker-compose.yml содержит все эти переменные со значениями по умолчанию
# (синтаксис ${VAR:-default}), поэтому система работает БЕЗ .env файла.
#
# .env с реальными API-ключами НЕ хранится в git (.gitignore).
# При деплое на VPS он копируется отдельно через rsync/scp.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=honeypot
POSTGRES_PASSWORD=securepass123
POSTGRES_DB=honeypot

# --- LLM Provider (openai или deepseek) ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING=enabled

# --- OpenAI (если LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Threat Intelligence ---
ABUSEIPDB_API_KEY=

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Redis ---
REDIS_STREAM=cowrie:events

# --- URLs ---
DASHBOARD_URL=http://167.71.54.188
